# Supabase (EU project). Only these two values reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Label printer (Zebra ZD230T, raw ZPL over TCP). Server only.
PRINTER_HOST=
PRINTER_PORT=9100

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Server only.
CRON_SECRET=

# Development only: skip sign-in and use a fake profile. Ignored in production builds.
NEXT_PUBLIC_DEV_NO_AUTH=0
NEXT_PUBLIC_DEV_ROLE=owner
