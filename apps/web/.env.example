# Supabase (EU project). Only these two values reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Label printer (Zebra ZD230T, raw ZPL over TCP). Server only.
PRINTER_HOST=
PRINTER_PORT=9100

# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>". Server only.
CRON_SECRET=

# Cron routes only (/api/cron/digest, /api/cron/alerts). Server only: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Base URL used for the links inside the digest and alert messages.
APP_URL=https://depo.example.com

# Email through the Resend HTTP API. The channel is skipped when RESEND_API_KEY or DIGEST_EMAIL_FROM is empty.
RESEND_API_KEY=
DIGEST_EMAIL_FROM=Dayson Depo <depo@example.com>
# Fallback recipients (comma separated) when no owner / ops_manager has an email in app_user.
DIGEST_EMAIL_TO=

# Telegram Bot API. The channel is skipped when TELEGRAM_BOT_TOKEN is empty.
TELEGRAM_BOT_TOKEN=
# Fallback chat (comma separated ids) when no owner / ops_manager has telegram_chat_id in app_user.
TELEGRAM_CHAT_ID=

# Development only: skip sign-in and use a fake profile. Ignored in production builds.
NEXT_PUBLIC_DEV_NO_AUTH=0
NEXT_PUBLIC_DEV_ROLE=owner
