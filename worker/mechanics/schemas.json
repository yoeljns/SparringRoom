{
  "buy_x_get_y": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "buy_item_rule": {
        "additionalProperties": false,
        "description": "Attribute filter or explicit list (spec §3.6 campaign_scope rules). Accepts the database spelling (family, attributes, skus) and the order-entry spelling (family_code, attrs); all given conditions must hold.",
        "minProperties": 1,
        "properties": {
          "all": {
            "type": "boolean"
          },
          "attributes": {
            "type": "object"
          },
          "attrs": {
            "type": "object"
          },
          "family": {
            "type": "string"
          },
          "family_code": {
            "type": "string"
          },
          "family_id": {
            "type": "string"
          },
          "item_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "skus": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      },
      "buy_qty": {
        "minimum": 1,
        "type": "integer"
      },
      "free_item": {
        "description": "item id, or 'same' for the bought item",
        "minLength": 1,
        "type": "string"
      },
      "free_qty": {
        "minimum": 1,
        "type": "integer"
      },
      "max_per_order": {
        "description": "max rewarded multiples per order; null = no cap",
        "minimum": 1
      }
    },
    "required": [
      "buy_item_rule",
      "buy_qty",
      "free_item",
      "free_qty"
    ],
    "title": "buy_x_get_y",
    "type": "object"
  },
  "export_push": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "items": {
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "market": {
        "minLength": 1,
        "type": "string"
      },
      "terms": {
        "additionalProperties": true,
        "description": "commercial terms (object or free text); discount_pct is used for the depth band and settlement",
        "properties": {
          "discount_pct": {
            "maximum": 100,
            "minimum": 0,
            "type": "number"
          },
          "incoterm": {
            "type": "string"
          },
          "payment_days": {
            "minimum": 0,
            "type": "integer"
          }
        }
      }
    },
    "required": [
      "market",
      "items",
      "terms"
    ],
    "title": "export_push",
    "type": "object"
  },
  "gift_item": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "gift_item": {
        "minLength": 1,
        "type": "string"
      },
      "qty": {
        "minimum": 1,
        "type": "integer"
      },
      "threshold_eur": {
        "exclusiveMinimum": 0
      },
      "threshold_qty": {
        "exclusiveMinimum": 0
      }
    },
    "required": [
      "gift_item",
      "qty"
    ],
    "title": "gift_item",
    "type": "object"
  },
  "launch_seed": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "item": {
        "minLength": 1,
        "type": "string"
      },
      "seed_qty": {
        "additionalProperties": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "description": "segment -> seed quantity per dealer",
        "minProperties": 1,
        "type": "object"
      }
    },
    "required": [
      "item",
      "seed_qty"
    ],
    "title": "launch_seed",
    "type": "object"
  },
  "mixed_set": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "bundle_id": {
        "minLength": 1,
        "type": "string"
      },
      "price": {
        "minimum": 0,
        "type": "number"
      }
    },
    "required": [
      "bundle_id",
      "price"
    ],
    "title": "mixed_set",
    "type": "object"
  },
  "price_discount": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "discount_pct": {
        "exclusiveMinimum": 0,
        "maximum": 100,
        "type": "number"
      }
    },
    "required": [
      "discount_pct"
    ],
    "title": "price_discount",
    "type": "object"
  },
  "target_rebate": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "period": {
        "additionalProperties": false,
        "properties": {
          "from": {
            "format": "date",
            "type": "string"
          },
          "to": {
            "format": "date",
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "type": "object"
      },
      "rebate_pct": {
        "exclusiveMinimum": 0,
        "maximum": 100,
        "type": "number"
      },
      "targets": {
        "additionalProperties": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "description": "segment -> net sales target in EUR",
        "minProperties": 1,
        "type": "object"
      }
    },
    "required": [
      "period",
      "targets",
      "rebate_pct"
    ],
    "title": "target_rebate",
    "type": "object"
  },
  "volume_tier": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "tiers": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "discount_pct": {
              "exclusiveMinimum": 0,
              "maximum": 100,
              "type": "number"
            },
            "min_qty": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "required": [
            "min_qty",
            "discount_pct"
          ],
          "type": "object"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "tiers"
    ],
    "title": "volume_tier",
    "type": "object"
  }
}
