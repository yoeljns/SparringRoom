      "required": true
    },
    {
      "name": "logo_cari_code",
      "type": "string",
      "required": true
    },
    {
      "name": "logo_item_code",
      "type": "string",
      "required": true
    },
    {
      "name": "qty",
      "type": "decimal",
      "required": true
