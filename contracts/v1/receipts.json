      "type": "date",
      "required": true
    },
    {
      "name": "supplier_code",
      "type": "string",
      "required": true
    },
    {
      "name": "logo_item_code",
      "type": "string",
      "required": true
    },
    {
      "name": "qty",
      "type": "decimal",
      "required": true
    },
    {
      "name": "lot_no",
      "type": "string",
      "required": true
    }
  ]
