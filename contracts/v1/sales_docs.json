{
  "schema": "v1",
  "type": "sales_docs",
  "direction": "inbound",
  "description": "Demand history, shipment matching, reconciliation",
  "file_name": "<type>_<YYYYMMDD>_<seq>.csv",
  "first_line": "#schema=v1",
  "encoding": "UTF-8",
  "separator": ";",
  "decimal": ".",
  "date_format": "YYYY-MM-DD",
  "columns": [
    {
      "name": "doc_type",
      "type": "enum",
      "required": true,
      "values": [
        "irsaliye",
        "invoice"
      ]
    },
    {
      "name": "doc_no",
      "type": "string",
      "required": true
    },
    {
      "name": "doc_date",
      "type": "date",
      "required": true
    },
    {
      "name": "logo_cari_code",
      "type": "string",
      "required": true
    },
    {
      "name": "logo_item_code",
      "type": "string",
      "required": true
    },
    {
      "name": "qty",
      "type": "decimal",
      "required": true
    },
    {
      "name": "unit",
      "type": "string",
      "required": true
    },
    {
      "name": "unit_price_eur",
      "type": "decimal",
      "required": false
    },
    {
      "name": "is_free",
      "type": "boolean",
      "required": true
    },
    {
      "name": "e_irsaliye_no",
      "type": "string",
      "required": false
    },
    {
      "name": "ref_shipment_id",
      "type": "string",
      "required": false
    }
  ]
}
